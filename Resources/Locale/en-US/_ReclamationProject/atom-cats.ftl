department-AtomCats = Atom Cats
department-AtomCats-description = The Atom Cats scavenge power armor and run a repair garage. Lookouts grow into Greasers, Muscle, Rockers, and finally Hot Rods. The Underboss and Boss handle faction business in character.
access-atom-cats = Atom Cats garage
atom-cats-switchblade-name = Atom Cats switchblade ID{ $jobSuffix }
atom-cats-switchblade-full-name = { $fullName }’s Atom Cats switchblade ID{ $jobSuffix }
atom-cats-switchblade-style = Style hair

job-name-atom-cats-lookout = Lookout
job-description-atom-cats-lookout = Watch the road from the garage and flag down scavengers with salvage to trade.
job-supervisors-atom-cats-lookout = the Greasers

job-name-atom-cats-greaser = Greaser
job-description-atom-cats-greaser = Strip wrecked frames, sort the usable parts, and help get customers back on their feet.
job-supervisors-atom-cats-greaser = the Muscle

job-name-atom-cats-muscle = Muscle
job-description-atom-cats-muscle = Keep the repair crew safe on salvage runs. Bring the crew and their haul home in one piece.
job-supervisors-atom-cats-muscle = the Rockers

job-name-atom-cats-rocker = Rocker
job-description-atom-cats-rocker = Run the shop floor, teach the new Cats, and decide which stalled rigs get a bay first.
job-supervisors-atom-cats-rocker = the Hot Rod

job-name-atom-cats-hotrod = Hot Rod
job-description-atom-cats-hotrod = Lead the working crew and make the deals that keep the garage stocked with parts.
job-supervisors-atom-cats-hotrod = the Underboss

job-name-atom-cats-underboss = Underboss
job-description-atom-cats-underboss = Help the crew settle in-character disputes and keep the garage running when the Boss is away.
job-supervisors-atom-cats-underboss = the Boss

job-name-atom-cats-boss = Boss
job-description-atom-cats-boss = Speak for the Atom Cats and steer the faction's in-character business.
job-supervisors-atom-cats-boss = your own judgment

job-name-atom-cats-tattoo-artist = Tattoo Artist
job-description-atom-cats-tattoo-artist = Keep a book of flash designs at the garage, tend to injured Cats, and patch up customers who come in from the road.
job-supervisors-atom-cats-tattoo-artist = the Rocker
