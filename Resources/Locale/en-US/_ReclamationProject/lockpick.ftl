lockpick-examine = It has [color=yellow]{$picks}[/color] {$picks ->
    [one] pick
   *[other] picks
} left.
lockpick-powered = This door runs on power. A lockpick won't help; try an emag.
lockpick-not-locked = That isn't locked.
lockpick-window-title = Lockpicking
lockpick-tension = Tension
lockpick-tension-light = Light
lockpick-tension-right = Right
lockpick-tension-heavy = Too heavy
lockpick-release = Release tension
lockpick-strain = Pick strain
lockpick-picks-left = {$picks} picks left
lockpick-help = Move the mouse to slide the pick under a pin. Hold and drag up to lift. Let go when the top of the brass pin meets the line.
lockpick-legend = Pins: plain, spool (thin waist), serrated (ridges). Keep tension on Right.
lockpick-not-binding = Loose and springy. That pin is not binding yet.
lockpick-overset = Overset. The pin jammed above the line. Release tension to reset.
lockpick-too-low = Too low. It springs back down.
lockpick-ridge = It caught on a ridge. Keep going up.
lockpick-false-set = False set. The plug turned too far and a spool pin is caught on its waist. Ease tension to light and lift it again.
lockpick-spool-push = The spool pushes back against the wrench. Ease tension to light first.
lockpick-spool-set = Click. The spool slipped past. Bring tension back up.
lockpick-serrated-set = Click. That one was the real set.
lockpick-set = Click. The plug turns a hair.
lockpick-unlocked = The plug turns all the way. Door unlocked.
lockpick-unlocked-popup = The lock gives.
lockpick-reset = You ease off the wrench. Every pin drops.
lockpick-snap = Snap. Too much tension broke the pick.
lockpick-all-broken = Your last pick snapped.
lockpick-slip = Too little tension for too long. A set pin slipped back down.
lockpick-interrupted = You lose your grip on the lock.
