# #Reclamation Project - medieval weapons
trait-name-ReclamationBlacksmith = Blacksmith
trait-description-ReclamationBlacksmith = You learned the hammer and the anvil the old way. At a forge you can make medieval weapons (swords, axes, polearms, shields, bows, crossbows, matchlocks and musket balls) and medieval armour. Without this trait the forge shows the recipes but you can't make them.
rp-blacksmith-denied = You don't know how to forge this. You need the Blacksmith trait.
rp-sling-too-big = {CAPITALIZE(THE($item))} is too big for the sling.
rp-crossbow-not-spanned = Crank the crossbow first (use it in hand, or E / right-click > Crank on the ground) before loading an arrow.
rp-crossbow-spanning = You start cranking back the string...
rp-crossbow-already-spanned = The string is already drawn. Load an arrow.
rp-crossbow-crank-verb = Crank
lathe-category-rp-blacksmith-weapons = Smithing: weapons
lathe-category-rp-blacksmith-armor = Smithing: armour
