department-Railroad = Railroad
department-Railroad-description = A secretive network blending into the wasteland while smuggling people and resources. Safehouse 1 focuses on freeing slaves; Safehouse 2 focuses on smuggling supplies. Each safehouse operates independently under its own Owner.

job-name-railroadsafehouse1intern = Railroad Intern (Safehouse 1)
job-description-railroadsafehouse1intern = Learn safehouse work and assist its members. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1intern = Safehouse 1 Conductor and Safehouse Owner

job-name-railroadsafehouse1worker = Railroad Worker (Safehouse 1)
job-description-railroadsafehouse1worker = Support safehouse operations while blending in with local wastelanders. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1worker = Safehouse 1 Conductor and Safehouse Owner

job-name-railroadsafehouse1agent = Railroad Agent (Safehouse 1)
job-description-railroadsafehouse1agent = Operate undercover outside the regular chain of command; report directly to your Safehouse Owner. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1agent = Safehouse 1 Owner

job-name-railroadsafehouse1runner = Railroad Runner (Safehouse 1)
job-description-railroadsafehouse1runner = Handle base-side logistics and organize smuggling runs. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1runner = Safehouse 1 Conductor and Safehouse Owner

job-name-railroadsafehouse1conductor = Railroad Conductor (Safehouse 1)
job-description-railroadsafehouse1conductor = Serve as second in command and coordinate the safehouse under its Owner. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1conductor = Safehouse 1 Owner

job-name-railroadsafehouse1safehouseowner = Railroad Safehouse Owner (Safehouse 1)
job-description-railroadsafehouse1safehouseowner = Lead this safehouse independently and direct its operations. This safehouse focuses on freeing enslaved people.
job-supervisors-railroadsafehouse1safehouseowner = the Railroad Alpha Leader

job-name-railroadsafehouse2intern = Railroad Intern (Safehouse 2)
job-description-railroadsafehouse2intern = Learn safehouse work and assist its members. This safehouse focuses on smuggling items and resources.
job-supervisors-railroadsafehouse2intern = Safehouse 2 Conductor and Safehouse Owner

job-name-railroadsafehouse2worker = Railroad Worker (Safehouse 2)
