triggermen-id-king-name = king of spades
triggermen-id-king-full-name = {$fullName}'s king of spades
triggermen-id-jack-name = jack of spades
triggermen-id-jack-full-name = {$fullName}'s jack of spades
job-name-triggermensotocapo = Sotocapo
job-description-triggermensotocapo = Serve as Underboss, coordinate the family and oversee the Capos. The Consigliere is your equal in rank.
job-supervisors-triggermensotocapo = the Don
job-name-triggermenconsigliere = Consigliere
job-description-triggermenconsigliere = A side promotion from Capo. Advise the Don and plan tactics, equal in rank to the Sotocapo rather than above or below them.
job-supervisors-triggermenconsigliere = the Don
job-name-triggermensoldato = Soldato
job-description-triggermensoldato = A trusted soldier of the family. Collect debts, enforce protection rackets, and guide the Associati.
job-supervisors-triggermensoldato = your Capo, the Sotocapo, and the Don
job-name-triggermencommissionmember = Membro Della Commissione
job-description-triggermencommissionmember = An admin-controlled Commission member used to handle in-character issues within the family.
job-supervisors-triggermencommissionmember = the Capo Dei Capi
job-name-triggermencapodeicapi = Capo Dei Capi
job-description-triggermencapodeicapi = The highest admin-controlled Triggermen rank, above the Commission and all player ranks.
job-supervisors-triggermencapodeicapi = your own judgment and the server rules
